.venv/
__pycache__/
*.pyc

# generated reports + debug dumps
report*.html
*.prompt.txt
*.reply.txt
.seam-session-graph.json

# diffs fed to the tool (keep the sample fixture, the curated demo samples, eval cases, and TS test fixtures)
*.patch
!sample.patch
!samples/*.patch
!eval/cases/*.patch
!ts/test/cases/*.patch
!ts/test/fixtures/**/*.patch

# eval harness: cached LLM generations are reproducible, don't track them
eval/_runs/

vscode-extension/node_modules/
vscode-extension/out/
vscode-extension/*.vsix
eval/cases/repos.json

# eval harness run-sets (regenerated on demand)
eval/_runs/

# TS harness run cache (regenerated by ts/eval/harness.ts generate)
ts/eval/_runs/

# Auto-grow stability harness run cache (regenerated by ts/eval/autogrow_harness.ts generate)
ts/eval/_autogrow_runs/

# compiled single-binary (bun build --compile) — large (~100MB), regenerated on demand
ts/dist/

# dependencies
ts/node_modules/
mcp/node_modules/

# Anchor-recall validation run cache (regenerated by ts/eval/anchor_recall_harness.ts)
ts/eval/_anchor_runs/
