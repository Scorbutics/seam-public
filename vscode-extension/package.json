{
  "name": "seam",
  "displayName": "Seam — review by intent",
  "description": "Decompose a diff into seams (core/link/environment/test/noise) and review by intent: seam colours on the native diff + a seam tree, powered by the Seam Python pipeline.",
  "version": "0.0.1",
  "publisher": "seam-local",
  "engines": { "vscode": "^1.84.0" },
  "categories": ["SCM Providers", "Visualization"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "seam.review", "title": "Seam: Review working changes", "icon": "$(symbol-color)" },
      { "command": "seam.reviewCommit", "title": "Seam: Review a commit…" },
      { "command": "seam.analyzeCodebase", "title": "Seam: Analyze codebase from anchor (cursor)", "icon": "$(target)" },
      { "command": "seam.analyzeModule", "title": "Seam: Analyze module (all exports of this file)", "icon": "$(symbol-namespace)" },
      { "command": "seam.analyzeFromIntent", "title": "Seam: Find footprint by intent…", "icon": "$(search-fuzzy)" },
      { "command": "seam.expandNode", "title": "Seam: Expand → consumers (who uses this)", "icon": "$(arrow-up)" },
      { "command": "seam.expandDown", "title": "Seam: Expand → dependencies (what this uses)", "icon": "$(arrow-down)" },
      { "command": "seam.showAll", "title": "Seam: Show all seams", "icon": "$(eye)" },
      { "command": "seam.prev", "title": "Seam: Previous hunk", "icon": "$(arrow-up)" },
      { "command": "seam.next", "title": "Seam: Next hunk", "icon": "$(arrow-down)" },
      { "command": "seam.clear", "title": "Seam: Clear decorations", "icon": "$(clear-all)" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "seam", "title": "Seam", "icon": "$(symbol-color)" }
      ]
    },
    "views": {
      "seam": [
        { "id": "seam.tree", "name": "Seams", "icon": "$(symbol-color)" }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "seam.review", "when": "view == seam.tree", "group": "navigation@1" },
        { "command": "seam.analyzeCodebase", "when": "view == seam.tree", "group": "navigation@2" },
        { "command": "seam.analyzeModule", "when": "view == seam.tree", "group": "navigation@2" },
        { "command": "seam.analyzeFromIntent", "when": "view == seam.tree", "group": "navigation@2" },
        { "command": "seam.prev", "when": "view == seam.tree", "group": "navigation@3" },
        { "command": "seam.next", "when": "view == seam.tree", "group": "navigation@4" },
        { "command": "seam.showAll", "when": "view == seam.tree", "group": "navigation@5" },
        { "command": "seam.clear", "when": "view == seam.tree", "group": "navigation@6" }
      ],
      "editor/context": [
        { "command": "seam.analyzeCodebase", "when": "editorTextFocus", "group": "navigation@9" },
        { "command": "seam.analyzeModule", "when": "editorTextFocus", "group": "navigation@9" }
      ],
      "view/item/context": [
        { "command": "seam.expandNode", "when": "view == seam.tree && viewItem == seamExpandable", "group": "inline@1" },
        { "command": "seam.expandDown", "when": "view == seam.tree && viewItem == seamExpandable", "group": "inline@2" }
      ]
    },
    "keybindings": [
      { "command": "seam.next", "key": "alt+]", "when": "seam.active" },
      { "command": "seam.prev", "key": "alt+[", "when": "seam.active" }
    ],
    "configuration": {
      "title": "Seam",
      "properties": {
        "seam.toolPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the code-review-sort checkout (containing decompose.py and .venv). Defaults to a bundled path if empty."
        },
        "seam.python": {
          "type": "string",
          "default": "",
          "description": "Python interpreter to run the pipeline. Defaults to <toolPath>/.venv/bin/python."
        },
        "seam.engine": {
          "type": "string",
          "enum": ["hybrid", "det", "llm"],
          "enumDescriptions": [
            "Default. LLM clustering (product intent) + deterministic roles & wiring, fed AST facts (defines/enclosing) from the editor's language server.",
            "Fully deterministic, offline — no LLM at all (structural cluster labels instead of product-intent prose).",
            "All passes by the LLM."
          ],
          "default": "hybrid",
          "description": "How to decompose a diff: 'hybrid' (LLM clusters + deterministic roles/wiring — best; needs a CLI for clustering), 'det' (fully offline, no LLM), or 'llm' (all LLM)."
        },
        "seam.codebaseDepth": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 4,
          "description": "Codebase mode (Analyze from anchor): how many call-graph hops to resolve outward from the anchor. Higher = more context but slower / larger (the anchor-bounded BFS depth)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.84.0",
    "typescript": "^5.4.0"
  }
}
