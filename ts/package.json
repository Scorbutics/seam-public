{
  "name": "seam-ts",
  "version": "0.0.1",
  "description": "TypeScript port of Seam — review-by-intent diff decomposition. Deterministic core first; see PORT-STATUS.md.",
  "type": "module",
  "bin": {
    "seam": "./src/cli/decompose.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:arch": "bun test test/architecture.test.ts",
    "test:core": "bun test test/core",
    "test:coupling": "bun test test/coupling",
    "test:scan": "bun test test/scan",
    "test:grow": "bun test test/grow",
    "test:anchor": "bun test test/anchor",
    "test:languages": "bun test test/languages",
    "test:codebase": "bun test test/codebase",
    "test:diff": "bun test test/diff",
    "typecheck": "tsc --noEmit -p .",
    "build": "bun build src/cli/decompose.ts --compile --outfile dist/seam"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.25.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
