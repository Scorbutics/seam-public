  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.25.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
