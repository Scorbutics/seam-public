+    it('injects the official account as a LOCKED Connecter on shared networks and excludes it from the peer pool', async () => {
+        const members = createMembers(4, 'linkedin'); // m_linkedin_0..3
+        const acme = new Member('acme', 'BOOST', 'Tech/SaaS');
+        acme.addSocialMedia('linkedin', 'https://linkedin.com/acme');
+        acme.addSocialMedia('youtube', 'https://youtube.com/@acme');
+        acme.isOfficial = true;
+
+        const repos = createMissionEngineInMemoryRepositories([...members, acme]);
+        const engine = new MissionEngine(repos);
+        const tasks = await engine.generate(1);
+
+        // Official never gets its own task.
+        expect(tasks.find(t => t.memberId === 'acme')).toBeUndefined();
+
+        for (const m of members) {
+            const task = tasks.find(t => t.memberId === m.id)!;
+            const connect = task.platformTasks['linkedin_CONNECT'].targets;
+            // Locked official target present on the shared network (linkedin)…
+            const official = connect.find(t => t.memberId === 'acme');
+            expect(official).toBeDefined();
+            expect(official!.locked).toBe(true);
+            expect(official!.action).toBe('subscription');
+            // …and only once (not also injected as a random peer pick).
+            expect(connect.filter(t => t.memberId === 'acme').length).toBe(1);
+            // No youtube action (member doesn't share youtube with the official).
+            expect(task.platformTasks['youtube_CONNECT']).toBeUndefined();
+            expect(task.platformTasks['youtube_CONTACT']).toBeUndefined();
+        }
+    });
+
