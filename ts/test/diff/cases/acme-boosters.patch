+        await repos.subscription.saveAll([`${members[0].id}:acme:linkedin`]);
+
+        const engine = new MissionEngine(repos);
+        const tasks = await engine.generate(1);
+        const t0 = tasks.find(t => t.memberId === members[0].id)!;
+
+        // m0 is connected → Contacter (locked), not Connecter.
